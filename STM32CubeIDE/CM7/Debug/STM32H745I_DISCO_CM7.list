  * @brief  Command handler for CMD 0x0B FUNC_ID_SERIAL_API_SETUP ZW->HOST: Cmd | CmdRes[]
  * @param  None
  * @retval None
  */
void ZWave_RES_CMD_0B_Serial_API_Setup(void)
{
